{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", ":disableDependencyDashboard"],
  "packageRules": [
    {
      "matchPackageNames": ["dotnet-sdk"],
      "matchUpdateTypes": ["patch"],
      "enabled": false,
      "description": "Using automatic roll-forward instead of explicit update"
    },
    {
      "matchPackagePatterns": ["Test", "Assert", "Mock", "[Xx]unit", "Moq"],
      "groupName": "Testing deps",
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchPackagePatterns": ["^TypedRest"],
      "groupName": "TypedRest",
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchPackageNames": ["Scalar.AspNetCore"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchPackagePatterns": ["^Microsoft\\.Extensions", "^Microsoft\\.AspNetCore", "^Microsoft\\.EntityFrameworkCore"],
      "groupName": "Microsoft Extensions",
      "automerge": true,
      "automergeType": "branch",
      "separateMinorPatch": true
    },
    {
      "matchPackagePatterns": ["^Microsoft\\.Extensions", "^Microsoft\\.AspNetCore", "^Microsoft\\.EntityFrameworkCore"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ]
}
